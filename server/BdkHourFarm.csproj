<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BdkHourFarm</AssemblyName>
    <RootNamespace>BdkHourFarm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Web\**;deploy\**" />
    <None Remove="Web\**" />
    <EmbeddedResource Include="Web\index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
